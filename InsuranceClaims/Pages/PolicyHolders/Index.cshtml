@page
@model InsuranceClaims.Pages.PolicyHolders.IndexModel
@{
	ViewData["Title"] = "Policyholders";
}

<h1>Policyholders</h1>
<a class="btn btn-primary mb-3" asp-page="Create">New policyholder</a>
<form method="get" class="row g-2 mb-3">
	<div class="col-md-9">
		<input name="search" value="@Model.Search" class="form-control" placeholder="Name, email, phone, or policy number" />
	</div>
	<div class="col-md-3">
		<button class="btn btn-outline-primary">Search</button>
	</div>
</form>
<table class="table table-bordered">
	<thead>
		<tr><th>Name</th><th>Email</th><th>Phone</th><th>Policy number</th><th></th></tr>
	</thead>
	<tbody>
	@foreach (var policyHolder in Model.PolicyHolders)
	{
		<tr>
			<td>@policyHolder.FirstName @policyHolder.LastName</td>
			<td>@policyHolder.Email</td>
			<td>@policyHolder.Phone</td>
			<td>@policyHolder.PolicyNumber</td>
			<td>
				<a class="btn btn-sm btn-outline-primary me-2" asp-page="Details" asp-route-policyHolderId="@policyHolder.PolicyHolderId">Details</a>
				<a class="btn btn-sm btn-outline-secondary me-2" asp-page="Edit" asp-route-policyHolderId="@policyHolder.PolicyHolderId">Edit</a>
				<form method="post" asp-page-handler="Remove" class="d-inline">
					<input type="hidden" name="policyHolderId" value="@policyHolder.PolicyHolderId" />
					<input type="hidden" name="search" value="@Model.Search" />
					<button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
				</form>
			</td>
		</tr>
	}
	</tbody>
</table>
@if (!string.IsNullOrEmpty(Model.Message))
{
	<div class="text-danger mt-3">@Model.Message</div>
}

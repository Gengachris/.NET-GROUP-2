@page
@model InsuranceClaims.Pages.Approvals.IndexModel
@{
    ViewData["Title"] = "Approvals";
}

<h1>Claims pending approval</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<table class="table table-bordered">
    <thead>
        <tr><th>Claim</th><th>Date</th><th>Policyholder</th><th>Branch</th><th>Amount</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var claim in Model.Claims)
        {
            <tr>
                <td>@claim.ClaimNumber</td>
                <td>@claim.ClaimDate.ToString("yyyy-MM-dd")</td>
                <td>@claim.PolicyHolderName</td>
                <td>@claim.BranchName</td>
                <td>@claim.ClaimAmount.ToString("N2")</td>
                <td><a class="btn btn-sm btn-primary" asp-page="Review" asp-route-id="@claim.ClaimId">Review</a></td>
            </tr>
        }
        @if (Model.Claims.Count == 0)
        {
            <tr><td colspan="6" class="text-center text-muted">No claims are waiting for approval.</td></tr>
        }
    </tbody>
</table>
@page
@model InsuranceClaims.Pages.Users.EditModel
@{
    ViewData["Title"] = "Edit employee";
}

<h1>Edit employee</h1>
<form method="post">
    <input type="hidden" asp-for="UserId" />
    <div class="mb-3">
        <label class="form-label">Username</label>
        <input asp-for="UserName" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input asp-for="Email" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Role</label>
        <select asp-for="RoleId" asp-items="Model.RoleList" class="form-select"></select>
    </div>
    <div class="mb-3 form-check">
        <input asp-for="IsActive" class="form-check-input" />
        <label class="form-check-label" asp-for="IsActive">Active</label>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-link" asp-page="Index">Back</a>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="text-danger mt-3">@Model.ErrorMessage</div>
    }
</form>

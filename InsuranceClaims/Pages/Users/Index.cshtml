@page
@model InsuranceClaims.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Users";
}

<h1>Users</h1>
<a class="btn btn-primary mb-3" asp-page="Create">New employee</a>
<table class="table">
    <thead>
        <tr>
            <th>Username</th>
            <th>Email</th>
            <th>Role</th>
            <th>Active</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var user in Model.Users)
    {
        <tr>
            <td>@user.UserName</td>
            <td>@user.Email</td>
            <td>@user.RoleName</td>
            <td>@(user.IsActive ? "Yes" : "No")</td>
            <td>
                <form method="post" asp-page-handler="Remove">
                    <input type="hidden" name="userId" value="@user.UserId" />
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
</tbody>
</table>
@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="mt-3">@Model.Message</div>
}

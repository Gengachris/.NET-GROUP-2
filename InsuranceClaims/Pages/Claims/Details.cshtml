@page
@model InsuranceClaims.Pages.Claims.DetailsModel
@{
    ViewData["Title"] = Model.ClaimNumber;
}

<h1>@Model.ClaimNumber</h1>
<p><a asp-page="Index">Back to claims</a></p>
@if ((User.IsInRole("Administrator") || User.IsInRole("Claims Manager"))
     && (Model.Status == "Submitted" || Model.Status == "Under Review" || Model.Status == "Pending Documents"))
{
    <a class="btn btn-outline-secondary mb-3" asp-page="Edit" asp-route-claimId="@Model.ClaimId">Edit</a>
}

@if ((User.IsInRole("Administrator") || User.IsInRole("Claims Manager"))
     && (Model.Status == "Submitted" || Model.Status == "Pending Documents"))
{
    <form method="post" asp-page-handler="Review" class="d-inline">
        <input type="hidden" name="claimId" value="@Model.ClaimId" />
        <button class="btn btn-outline-primary mb-3">Mark under review</button>
    </form>
}
@if ((User.IsInRole("Administrator") || User.IsInRole("Claims Manager")) && Model.Status == "Under Review")
{
    <form method="post" asp-page-handler="Documents" class="d-inline">
        <input type="hidden" name="claimId" value="@Model.ClaimId" />
        <button class="btn btn-outline-secondary mb-3">Waiting for documents</button>
    </form>
}

@if ((User.IsInRole("Administrator") || User.IsInRole("Claims Manager"))
     && (Model.Status == "Submitted" || Model.Status == "Under Review" || Model.Status == "Pending Documents" || Model.Status == "Under Investigation"))
{
    <form method="post" asp-page-handler="Assign" class="mb-3">
        <input type="hidden" name="claimId" value="@Model.ClaimId" />
        <select name="adjusterId" class="form-select">
            <option value="">Choose an adjuster</option>
            @foreach (var item in Model.AdjusterList)
            {
                <option value="@item.Value">@item.Text</option>
            }
        </select>
        <button class="btn btn-primary mt-2">Assign</button>
    </form>
}
@if (!string.IsNullOrEmpty(Model.AssignError))
{
    <div class="text-danger mb-3">@Model.AssignError</div>
}
<table class="table table-bordered">
    <tr><th>Status</th><td>@Model.Status</td></tr>
    <tr><th>Policyholder</th><td>@Model.PolicyHolderName (@Model.PolicyNumber)</td></tr>
    <tr><th>Branch</th><td>@Model.BranchName</td></tr>
    <tr><th>Claim date</th><td>@Model.ClaimDate.ToString("yyyy-MM-dd")</td></tr>
    <tr><th>Incident date</th><td>@Model.IncidentDate.ToString("yyyy-MM-dd")</td></tr>
    <tr><th>Amount</th><td>@Model.ClaimAmount.ToString("N2")</td></tr>
    <tr><th>Location</th><td>@Model.IncidentLocation</td></tr>
    <tr><th>What happened</th><td>@Model.IncidentDescription</td></tr>
</table>
<h2>History</h2>
<table class="table table-bordered">
    <thead>
        <tr><th>When</th><th>From</th><th>To</th><th>By</th><th>Remarks</th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model.History)
    {
        <tr>
            <td>@item.ChangeDate.ToString("yyyy-MM-dd HH:mm")</td>
            <td>@item.OldStatus</td>
            <td>@item.NewStatus</td>
            <td>@item.UserName</td>
            <td>@item.Remarks</td>
        </tr>
    }
    </tbody>
</table>
